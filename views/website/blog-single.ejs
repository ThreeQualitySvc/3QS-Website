<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">

  <title><%=postItem.titleNormal%></title>
  <meta
          content="Your leading Digital Transformation Partner"
          name="description"
  >
  <meta
          content="
            cybersecurity in Kenya, information security, data security, IT security, network security,
            drone, UAV, unmanned aerial vehicle, drone solutions,
            digital payments, mobile payments, online payments, e-payments,
            enterprise architecture, IT architecture, systems architecture,
            Kenya, Kenyan, East Africa, Africa,
        "
          name="keywords"
  >

  <!-- Favicons -->
  <link rel="icon" href="/assets/images/logo/logo2.png">

  <!--  Bootstrap-->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

  <!--  jquery-->
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.1/jquery.min.js"></script>

  <!-- Fontawesome Files -->
  <link href="/assets/fontawesome/css/fontawesome.css" rel="stylesheet">
  <link href="/assets/fontawesome/css/brands.css" rel="stylesheet">
  <link href="/assets/fontawesome/css/solid.css" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="/assets/aos/aos.css" rel="stylesheet">

  <!-- Template Main CSS File -->
  <link href="/assets/css/single.css" rel="stylesheet">

</head>

<body>

  <%- include('partials/alerts') %>

  <!-- ======= Blog Section ======= -->
  <section class="breadcrumbs">
    <div class="container">

      <div class="d-flex justify-content-between align-items-center">
        <h2>Blog</h2>

        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/">Blog</a></li>
          <li><%= postItem.titleNormal %></li>
        </ol>
      </div>

    </div>
  </section><!-- End Blog Section -->

  <!-- ======= Blog Single Section ======= -->
  <section id="blog" class="blog">
    <div class="container" data-aos="fade-up">

      <div class="row">

        <div class="col-lg-8 entries">

          <article class="entry entry-single">

            <div class="entry-media">
              <% if (postItem.dayPhoto && postItem.dayPhoto.match(/\.(mp4|mkv|avi|mov)$/)) { %>
                  <video class="img-fluid" width="1200" height="600" controls autoplay>
                      <source src="/<%= postItem.dayPhoto %>" type="video/mp4">
                      Your browser does not support the video tag.
                  </video>
              <% } else if (postItem.dayPhoto) { %>
                  <img src="/<%= postItem.dayPhoto %>" alt="" class="img-fluid" width="1200" height="600" loading="lazy">
              <% } else { %>
                  <p>No media available</p>
              <% } %>
          </div>

            <h2 class="entry-title">
              <a href="blog-single.html"><%= postItem.titleNormal %></a>
            </h2>

            <div class="entry-meta">
              <ul>
                <li class="d-flex align-items-center"><i class="bi bi-person"></i> <a href=""><%=postItem.lastName%>, <%=postItem.firstName%></a></li>
                <li class="d-flex align-items-center"><i class="bi bi-clock"></i> <a href=""><time><%= postItem.day %></time></a></li>
              </ul>
            </div>

            <div class="entry-content">
              <p style="white-space: pre-line">
                <%= postItem.content %>
              </p>

            </div>

            <div class="entry-footer">
              <i class="bi bi-tags"></i>
              <ul class="tags">
                <%postItem.tags.forEach(x => {%>
                <li><a href="#"><%=x%></a></li>
                <%})%>
              </ul>
            </div>
            <div class="like_form">
              <form class="opinion_like post_like mx-3" method="post" action="/<%=postItem._id%>/green">
                <button type="submit" class="btn-opinion green" id="green"><i class="fa fa-thumbs-up fa-lg" aria-hidden="true"></i></button>
                <div class="opinion_count">
                  <p><%=postItem.likeCount%></p>
                </div>
              </form>
              <form class="opinion_dislike post_like mx-3" method="post" action="/<%=postItem._id%>/red">
                <button type="submit" class="btn-opinion red" id="red"><i class="fa fa-thumbs-down fa-lg" aria-hidden="true"></i></button>
                <div class="opinion_count">
                  <p><%=postItem.dislikeCount%></p>
                </div>
              </form>
            </div>

            <div class="link-copy-notify hide-at-first">
              <div class="bubble">
                <p style="font-size: 20px;color: #fff">Link Copied</p>
              </div>
            </div>

            <div class="share-button-div">
              <button class="share-button" onclick="copyPageUrl()">
                Share
                <i class="fa-solid fa-share-nodes fa-xl"></i>
              </button>
            </div>

          </article><!-- End blog entry -->

          <div class="blog-author d-flex align-items-center">
            <img src="/<%= postItem.profilePhoto %>" class="rounded-circle float-left" alt="">
            <div>
              <h4><%= postItem.firstName %></h4>
              <p class=""><%=postItem.email%></p>

              <div>
                <a class="social-buttons" href="https://twitter.com/ThreeQualitySvc" target="_blank"  style="padding-right: 1.2rem; color: #000"><i class="fa-brands fa-x-twitter fa-xl fa-beat"></i></a>
                <a class="social-buttons" href="https://www.linkedin.com/in/david-kanyanjua-6932a64/" target="_blank"  style="padding-right: 1.2rem; color: #000"><i class="fa-brands fa-linkedin fa-xl fa-bounce" style="--fa-beat-scale: 2.0;"></i></a>
                <a class="social-buttons" href="https://www.facebook.com/threequalityservices" target="_blank"  style="padding-right: 1.2rem; color: #000"><i class="fa-brands fa-facebook fa-xl fa-beat"></i></a>
                <a class="social-buttons" href="https://www.apple.com/" target="_blank"  style="padding-right: 1.2rem; color: #000"><i class="fa-brands fa-instagram fa-xl fa-bounce" style="--fa-beat-scale: 2.0;"></i></a>
              </div>

            </div>
          </div>
        </div>

        <div class="col-lg-4">

          <div class="sidebar">

            <h3 class="sidebar-title">Search</h3>
            <div class="sidebar-item search-form">
              <form action="">
                <input type="text">
                <button type="submit"><i class="bi bi-search"></i></button>
              </form>
            </div><!-- End sidebar search formn-->

            <h3 class="sidebar-title">Categories</h3>
            <div class="sidebar-item categories">
              <ul>
                <li><a href="/blog/Governance">Governance <span>(<%=gov%>)</span></a></li>
                <li><a href="/blog/Training">Training <span>(<%=training%>)</span></a></li>
                <li><a href="/blog/Data-Science">Data Science <span>(<%=datasci%>)</span></a></li>
                <li><a href="/blog/Business-&-Finance">Business & Finance <span>(<%=bcom%>)</span></a></li>
                <li><a href="/blog/Project-Management">Project Management <span>(<%=proj%>)</span></a></li>
                <li><a href="/blog/Cyber-Security">Cyber Security <span>(<%=cyberSec%>)</span></a></li>
              </ul>
            </div><!-- End sidebar categories-->

            <%- include('blogTypes/websitePartials/big5') %>
            <!-- End sidebar recent posts-->

          </div><!-- End sidebar -->

        </div><!-- End blog sidebar -->

      </div>

    </div>
  </section><!-- End Blog Single Section -->


<<a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

<!-- Vendor JS Files -->

<!--Another JS File-->
<script>
  async function copyPageUrl(){
    try {
      await navigator.clipboard.writeText(location.href);
      document.querySelector('.link-copy-notify').classList.toggle('hide-at-first')
      setTimeout(function() {
        document.querySelector('.link-copy-notify').classList.toggle('hide-at-first');
      }, 1500);
      console.log(location.href);
    } catch (e) {
      console.error('Failed: ', e)
    }
  }
</script>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="/assets/vendor/purecounter/purecounter_vanilla.js"></script>
<script src="/assets/vendor/aos/aos.js"></script>
<script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/assets/vendor/glightbox/js/glightbox.min.js"></script>
<script src="/assets/vendor/isotope-layout/isotope.pkgd.min.js"></script>
<script src="/assets/vendor/swiper/swiper-bundle.min.js"></script>
<script src="/assets/vendor/waypoints/noframework.waypoints.js"></script>

<!-- Template Main JS File -->
<script src="/assets/js/main.js"></script>>

</body>

</html>